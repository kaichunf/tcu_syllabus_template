\newcommand{\TCUHeadingOne}[1]{%
  \par\vspace{6pt}%
  \phantomsection\addcontentsline{toc}{section}{#1}%
  {\centering\color{TCUPurple}\bfseries\fontsize{16}{19}\selectfont
   \TCUSmallCapsText{16}{12.5}{#1}\par}%
  \vspace{-1pt}}
\newcommand{\TCUHeadingTwo}[1]{%
  \par\needspace{2\baselineskip}\vspace{6pt}%
  \phantomsection\addcontentsline{toc}{subsection}{#1}%
  {\color{TCUPurple}\bfseries\fontsize{14}{17}\selectfont #1\par}%
  \vspace{-2pt}}
\newcommand{\TCUHeadingThree}[1]{%
  \par\vspace{5pt}%
  \phantomsection\addcontentsline{toc}{subsubsection}{#1}%
  {\bfseries #1\par}%
  \vspace{-2pt}}
