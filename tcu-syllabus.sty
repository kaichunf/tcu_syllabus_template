% Per-character small-caps renderer (Arimo has no sc face in pdfLaTeX).
% Uppercase input chars → full size; lowercase input chars → uppercased at small size.
% tl_map_inline skips space tokens, so we split at spaces first with regex_split,
% then reassemble with explicit \space between words.
\ExplSyntaxOn
\bool_new:N \l_tcu_sc_first_bool
\seq_new:N  \l_tcu_sc_seq
\cs_new_protected:Npn \tcu_sc_text:nnn #1 #2 #3 {
  \regex_split:nnN { \x{20} } { #3 } \l_tcu_sc_seq
  \bool_set_true:N \l_tcu_sc_first_bool
  \seq_map_inline:Nn \l_tcu_sc_seq {
    \bool_if:NTF \l_tcu_sc_first_bool {
      \bool_set_false:N \l_tcu_sc_first_bool
    } {
      { \fontsize {#1} {#1} \selectfont \space }
    }
    \tl_map_inline:nn { ##1 } {
      \token_if_cs:NTF ####1
        { { \fontsize {#1} {#1} \selectfont ####1 } }
        {
          \int_compare:nNnTF { \char_value_lccode:n { `####1 } } = { `####1 }
            { { \fontsize {#2} {#2} \selectfont \MakeUppercase {####1} } }
            { { \fontsize {#1} {#1} \selectfont ####1 } }
        }
    }
  }
}
% Public interface: #1 = full size (pt), #2 = small size (pt), #3 = text
\NewDocumentCommand \TCUSmallCapsText { m m m } {
  \tcu_sc_text:nnn {#1} {#2} {#3}
}
\ExplSyntaxOff
